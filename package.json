{
  "name": "geolint",
  "version": "0.0.0",
  "description": "Fast quality gates for production GeoJSON.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "geolint": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node --input-type=module -e \"import { rm } from 'node:fs/promises'; await rm('dist', { recursive: true, force: true })\"",
    "test": "npm run build && node --test dist/test/*.test.js",
    "test:integration": "npm run test",
    "test:torture": "npm run build && node --test dist/test/torture-*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "check:deps": "depcruise --config .dependency-cruiser.cjs src",
    "check:dead-code": "knip",
    "check": "npm run typecheck && npm run lint && npm run check:deps && npm run check:dead-code",
    "format": "prettier --write src package.json tsconfig.json eslint.config.js .dependency-cruiser.cjs knip.json .github/workflows/*.yml README.md docs/*.md .prettierrc.json",
    "format:check": "prettier --check src package.json tsconfig.json eslint.config.js .dependency-cruiser.cjs knip.json .github/workflows/*.yml README.md docs/*.md .prettierrc.json",
    "benchmark": "npm run build && node dist/benchmark/index.js",
    "benchmark:extended": "npm run build && node dist/benchmark/index.js --extended",
    "benchmark:json": "npm run build && node dist/benchmark/index.js --json",
    "benchmark:compare": "npm run build && node dist/benchmark/compare-cli.js",
    "benchmark:workers": "npm run build && node dist/benchmark/worker-feasibility.js",
    "benchmark:workers:production": "npm run build && node dist/benchmark/worker-feasibility.js --production",
    "benchmark:workers:snapshot": "npm run build && node dist/benchmark/worker-snapshot.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@types/picomatch": "^4.0.3",
    "dependency-cruiser": "^18.1.1",
    "eslint": "^10.8.0",
    "knip": "^6.32.0",
    "prettier": "^3.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.66.0"
  },
  "dependencies": {
    "fast-glob": "^3.3.3",
    "jiti": "^2.7.0",
    "picomatch": "^4.0.5"
  }
}
